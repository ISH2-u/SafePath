<?xml version="1.0" encoding="utf-8"?>
<!-- SafePath AI — Network Security Configuration: Strict HTTPS for external domains, cleartext permitted for local loopback / USB development -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permit local development / ADB reverse over USB without compromising external HTTPS security -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>

