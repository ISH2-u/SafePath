<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Safety Status Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSystemStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_safe_green"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/color_safe_green"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSystemStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_status_protected"
                        android:textColor="@color/color_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="SafePath AI is active and monitoring safety signals"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PROMINENT MANUAL SOS BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickSos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="@string/quick_sos"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/color_sos_text"
            app:icon="@drawable/ic_sos"
            app:iconSize="28dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/color_sos_red"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:layout_marginBottom="14dp" />

        <!-- 1. CURRENT LOCATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/color_primary"
                        android:contentDescription="@string/card_location_title" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/card_location_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvLocationPermissionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking..."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLocationCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Location permission not yet granted. Tap below to enable GPS tracking."
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantLocationPermission"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="Grant Location Permission"
                    android:textColor="@color/color_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. CURRENT JOURNEY STATUS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJourneyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_journey"
                        app:tint="@color/color_secondary"
                        android:contentDescription="@string/card_journey_title" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/card_journey_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvJourneyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INACTIVE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface_variant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvJourneyDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No active journey currently monitored. Tap to set your destination and begin safe travel."
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. AREA-RISK INFORMATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAreaRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_map"
                        app:tint="@color/color_primary"
                        android:contentDescription="@string/card_risk_title" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/card_risk_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_demo"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="@string/demo_data_badge"
                        android:textColor="#4338CA"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRiskExplanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Demonstration advisory: Sector B-1 • Risk Level: Moderate (Low street lighting after 9 PM). Tap to view map overlay."
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. EMERGENCY CONTACTS STATUS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContactsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/color_safe_green"
                        android:contentDescription="@string/card_contacts_title" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/card_contacts_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_verified"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="3 CONFIGURED"
                        android:textColor="#16A34A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Strict Delivery Rule: Emergency alerts will dispatch strictly to your verified contacts list."
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. MICROPHONE MONITORING STATUS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/color_primary"
                        android:contentDescription="@string/card_mic_title" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/card_mic_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvMicStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTENING"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_safe_green" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="On-device hotword active: Secret phrase triggers silent SOS without phone interaction."
                    android:textSize="13sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions Navigation Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Modules"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"
            android:layout_marginBottom="10dp" />

        <!-- Grid of Action Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileVoiceCodeword"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/color_divider"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/color_primary"
                        android:contentDescription="Voice Codeword" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Voice Codeword"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileSafetyAssistant"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/color_divider"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_assistant"
                        app:tint="@color/color_secondary"
                        android:contentDescription="AI Assistant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="AI Assistant"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileProfile"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/color_divider"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/color_primary"
                        android:contentDescription="My Profile" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="My Profile"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileSettings"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/color_divider"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/color_on_surface_variant"
                        android:contentDescription="Settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Settings"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
