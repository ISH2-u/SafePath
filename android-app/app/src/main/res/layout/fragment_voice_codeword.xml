<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_codeword_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_codeword_instruction"
            android:textSize="13sp"
            android:textColor="@color/color_on_surface_variant" />

        <!-- Privacy & Protection Architecture Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#F8FAFC"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Privacy &amp; Battery Shield"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Continuous background microphone listening has been disabled to protect your privacy and battery life. Microphone access is strictly activated on-demand only when running in-app phrase tests below."
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Codeword Input Box -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCodeword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Personal Emergency Codeword Phrase">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodeword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blue Moon"
                android:inputType="textCapWords"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sensitivity Selection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detection Sensitivity"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Select how strictly your spoken words must match the configured phrase."
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />

                <RadioGroup
                    android:id="@+id/rgSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbBalanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="Balanced (70% match - recommended for noisy commute)" />

                    <RadioButton
                        android:id="@+id/rbHighSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="High Sensitivity (60% match - picks up quiet whispers)" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test Acoustic Feedback Card (Visible during test) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#F8FAFC"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listening for test phrase..."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:id="@+id/tvTestMatchScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Match Confidence: --"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestVoice"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Test Phrase Recognition (Safe Mode)"
            android:textSize="14sp"
            android:textColor="@color/color_primary"
            app:strokeColor="@color/color_primary"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveVoiceCodeword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="@string/voice_save_btn"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/color_primary" />

        <!-- Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="SafePath provides three primary SOS activation methods: physical Volume Up (3x), Quick Settings notification tile, and in-app SOS."
            android:textSize="11sp"
            android:textColor="@color/color_on_surface_variant"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
