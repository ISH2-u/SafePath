<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_codeword_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/voice_codeword_instruction"
            android:textSize="13sp"
            android:textColor="@color/color_on_surface_variant" />

        <!-- Monitoring Status & Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="1dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivServiceStatusIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_mic_off"
                        app:tint="@color/color_on_surface_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMonitoringStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Codeword Monitoring"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_surface" />

                        <TextView
                            android:id="@+id/tvMonitoringStatusSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Currently Inactive"
                            android:textSize="12sp"
                            android:textColor="@color/color_on_surface_variant" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVoiceMonitoring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="When active, SafePath continuously monitors on-device audio in the foreground. If you speak your phrase, emergency SOS dispatches immediately."
                    android:textSize="11sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy & Permissions Notice Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMicPermissionNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#F0FDF4"
            app:strokeColor="@color/color_safe_green"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/color_safe_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="100% On-Device Privacy Guaranteed"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_safe_green" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Microphone audio is processed entirely on your device. Audio recordings are never streamed to servers, saved to disk, or transmitted to any third party."
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Codeword Input Box -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCodeword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Personal Emergency Codeword Phrase">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodeword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blue Moon"
                android:inputType="textCapWords"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sensitivity Selection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detection Sensitivity"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Select how strictly your spoken words must match the configured phrase."
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />

                <RadioGroup
                    android:id="@+id/rgSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbBalanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="Balanced (70% match - recommended for noisy commute)" />

                    <RadioButton
                        android:id="@+id/rbHighSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="High Sensitivity (60% match - picks up quiet whispers)" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test Acoustic Feedback Card (Visible during test) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#F8FAFC"
            app:strokeColor="@color/color_outline_variant"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listening for test phrase..."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:id="@+id/tvTestMatchScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Match Confidence: --"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestVoice"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Test Phrase Recognition (Safe Mode)"
            android:textSize="14sp"
            android:textColor="@color/color_primary"
            app:strokeColor="@color/color_primary"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveVoiceCodeword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="@string/voice_save_btn"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/color_primary" />

        <!-- OS Limitation Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Note: Android limits background microphone access when the device is locked in deep sleep. Always keep the Manual SOS button on the home screen ready as your primary lifeline."
            android:textSize="11sp"
            android:textColor="@color/color_on_surface_variant"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
