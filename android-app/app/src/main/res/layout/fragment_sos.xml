<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Strict Privacy Policy Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#FEF2F2"
            app:strokeColor="@color/color_sos_red"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/color_sos_red"
                    android:contentDescription="Policy warning" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="STRICT POLICY: Alerts are dispatched ONLY to your verified emergency contacts. Never sent to police, authorities, or strangers."
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#991B1B" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sos_screen_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_sos_red"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvSosExplanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Tap to trigger immediate SOS dispatch. A 5-second cancel window allows aborting accidental presses."
            android:textSize="12sp"
            android:textColor="@color/color_on_surface_variant" />

        <!-- Giant SOS Button Container -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="SOS"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/color_sos_text"
                app:backgroundTint="@color/color_sos_red"
                app:cornerRadius="100dp"
                app:elevation="10dp" />
        </FrameLayout>

        <!-- Countdown / Dispatch Status -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready to trigger"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/color_safe_green" />

        <!-- Cancel button (shown during countdown) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSos"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/sos_cancel_btn"
            android:textColor="@color/color_sos_red"
            app:strokeColor="@color/color_sos_red"
            app:cornerRadius="12dp"
            android:visibility="gone" />

        <!-- Live SOS Delivery Confirmation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSosDeliveryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSosStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alert Dispatched"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_sos_red" />

                <TextView
                    android:id="@+id/tvSosStatusDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dispatched to verified contacts with live GPS coordinates."
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />

                <TextView
                    android:id="@+id/tvSosTelemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F1F5F9"
                    android:padding="8dp"
                    android:text="Coordinates: Lat --, Lng --"
                    android:textSize="11sp"
                    android:textColor="@color/color_on_surface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Silent Mode Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sos_silent_label"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dispatches alert silently without sounding local siren"
                        android:textSize="11sp"
                        android:textColor="@color/color_on_surface_variant" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSilentSos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
