<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".fragments.MapFragment">

    <!-- MapLibre Map View with OpenStreetMap tiles -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Telemetry & Safety Accuracy Overlay Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:layout_margin="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/color_primary"
                        android:contentDescription="Map Location" />

                    <TextView
                        android:id="@+id/tvMapCoords"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Location: Acquiring GPS..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvMapRouteStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface_variant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMapAccuracyDisclosed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accuracy: ± -- m (Satellite geometry determines precision)"
                    android:textSize="11sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Circular Area Risk Indicator Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAreaRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Risk Color Indicator Pill -->
                <View
                    android:id="@+id/viewRiskColorPill"
                    android:layout_width="12dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_verified" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRiskCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading area risk..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvRiskSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demonstration risk model · Tap for guidance"
                        android:textSize="11sp"
                        android:textColor="@color/color_on_surface_variant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/color_primary"
                    android:contentDescription="Risk Details" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Permission Needed Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapPermissionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FEF2F2"
        app:strokeColor="@color/color_sos_red"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/color_sos_red"
                android:contentDescription="Permission Warning" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Location permission required to display position on map."
                android:textSize="12sp"
                android:textColor="#991B1B"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapEnableLocation"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Left OpenStreetMap Attribution -->
    <TextView
        android:id="@+id/tvOsmAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="#80FFFFFF"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="© OpenStreetMap contributors"
        android:textSize="10sp"
        android:textColor="#334155" />

    <!-- Center On User Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCenterLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_my_location"
        android:contentDescription="Re-center Location"
        app:fabSize="normal"
        app:backgroundTint="@color/color_primary"
        app:tint="@android:color/white" />

</FrameLayout>
