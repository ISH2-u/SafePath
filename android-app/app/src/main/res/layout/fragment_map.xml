<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".fragments.MapFragment">

    <!-- MapLibre Map View with OpenStreetMap tiles -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Telemetry & Safety Accuracy Overlay Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:layout_margin="12dp">

        <!-- GPS Telemetry Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/color_primary"
                        android:contentDescription="Map Location" />

                    <TextView
                        android:id="@+id/tvMapCoords"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Location: Acquiring GPS..."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvMapRouteStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface_variant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMapAccuracyDisclosed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Accuracy: ± -- m (Satellite geometry determines precision)"
                    android:textSize="10sp"
                    android:textColor="@color/color_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Area Risk & H3 Grid Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAreaRisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Risk Color Indicator Pill -->
                <View
                    android:id="@+id/viewRiskColorPill"
                    android:layout_width="10dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_badge_verified" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRiskCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evaluating H3 Risk..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface" />

                    <TextView
                        android:id="@+id/tvRiskGridSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H3 Grid: Analyzing spatial cells..."
                        android:textSize="11sp"
                        android:textColor="@color/color_on_surface_variant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/color_primary"
                    android:contentDescription="Risk Details" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Compact 5-Tier Map Legend Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#F8FAFC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Legend:"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginEnd="6dp" />

                <!-- Green Low -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#16A34A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low"
                    android:textSize="9sp"
                    android:textColor="#334155"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="6dp" />

                <!-- Yellow Moderate -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#EAB308" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mod"
                    android:textSize="9sp"
                    android:textColor="#334155"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="6dp" />

                <!-- Orange High -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#F97316" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High"
                    android:textSize="9sp"
                    android:textColor="#334155"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="6dp" />

                <!-- Red Very High -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#EF4444" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V.High"
                    android:textSize="9sp"
                    android:textColor="#334155"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="6dp" />

                <!-- Grey No Data -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#94A3B8" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Data"
                    android:textSize="9sp"
                    android:textColor="#334155"
                    android:layout_marginStart="3dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Permission Needed Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapPermissionWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FEF2F2"
        app:strokeColor="@color/color_sos_red"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/color_sos_red"
                android:contentDescription="Permission Warning" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Location permission required to display position on map."
                android:textSize="12sp"
                android:textColor="#991B1B"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapEnableLocation"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Selected H3 Cell Inspector Card (Tap-to-select, PROMPT 9) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelectedCell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="72dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/color_surface"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Card Header: Title & Close Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewSelectedCellColor"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#16A34A" />

                <TextView
                    android:id="@+id/tvSelectedCellTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="H3 Cell Details"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_on_surface" />

                <ImageView
                    android:id="@+id/btnCloseSelectedCell"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/color_on_surface_variant"
                    android:contentDescription="Close Inspector" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedCellId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Index: 8860145945fffff"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/color_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#E2E8F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Risk Level: "
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_variant" />

                <TextView
                    android:id="@+id/tvSelectedCellRisk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low Risk"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/color_safe_green" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedCellIncidents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Incidents: 0 recorded incidents"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:id="@+id/tvSelectedCellPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Period: SafePath Baseline 2019-2023"
                android:textSize="11sp"
                android:textColor="@color/color_on_surface_variant" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Left OpenStreetMap Attribution -->
    <TextView
        android:id="@+id/tvOsmAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="#80FFFFFF"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="© OpenStreetMap contributors"
        android:textSize="10sp"
        android:textColor="#334155" />

    <!-- Center On User Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCenterLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_my_location"
        android:contentDescription="Re-center Location"
        app:fabSize="normal"
        app:backgroundTint="@color/color_primary"
        app:tint="@android:color/white" />

</FrameLayout>
