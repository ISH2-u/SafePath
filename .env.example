# ─── SafePath AI — Root Environment Template ──────────────────────────────────
# Copy this file to backend/.env and customize for your local development setup.
# NEVER commit .env to version control.

# Backend Application Settings
PROJECT_NAME="SafePath AI Backend"
API_V1_STR="/api/v1"
DEBUG=true

# Database Configuration
# Local SQLite (Default - zero external dependencies):
DATABASE_URL=sqlite:///./safepath.db
# Docker PostgreSQL (Production/Team Staging):
# DATABASE_URL=postgresql+psycopg2://safepath_user:CHANGE_ME_PASSWORD@localhost:5432/safepath_db

# Security & JWT Token Authentication
# Generate a secure 32+ character key for your instance:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Cloud Messaging / Admin SDK (Optional)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
