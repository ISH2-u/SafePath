# ─── SafePath AI Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

PROJECT_NAME="SafePath AI Backend"
API_V1_STR="/api/v1"
DEBUG=true

# PostgreSQL
POSTGRES_USER=safepath_user
POSTGRES_PASSWORD=CHANGE_ME_secure_password
POSTGRES_DB=safepath_db
DATABASE_URL=postgresql+psycopg2://safepath_user:CHANGE_ME_secure_password@localhost:5432/safepath_db

# JWT
SECRET_KEY=CHANGE_ME_at_least_32_chars_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Admin SDK (path to downloaded service account JSON)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

