# ─── SafePath AI Production Environment Configuration (.env.prod) ────────────
# Copy this file to .env.prod on your OCI server:
#     cp .env.prod.example .env.prod
# ─────────────────────────────────────────────────────────────────────────────

# ── General Server Settings ──────────────────────────────────────────────────
PROJECT_NAME="SafePath AI Backend"
ENVIRONMENT="production"
DEBUG="false"
API_V1_STR="/api/v1"

# ── Domain & Reverse Proxy (Caddy) ───────────────────────────────────────────
# For production HTTPS, provide your domain or free DuckDNS / sslip.io subdomain.
# Examples:
#   DOMAIN="safepath.yourdomain.com"
#   DOMAIN="safepath-app.duckdns.org"
#   DOMAIN="129-154-10-20.sslip.io"
# If deploying on raw IP without TLS initially, leave as: DOMAIN=":80"
DOMAIN="safepath.yourdomain.com"
ACME_EMAIL="admin@yourdomain.com"

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a strong 256-bit secret key by running: openssl rand -hex 32
SECRET_KEY="REPLACE_WITH_SECURE_RANDOMLY_GENERATED_64_CHAR_HEX_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080" # 7 days for mobile app session persistence

# ── PostgreSQL Database Configuration ────────────────────────────────────────
# PostgreSQL is isolated on an internal Docker network (NOT accessible via public internet)
POSTGRES_USER="safepath_admin"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_DB_PASSWORD_MIN_16_CHARS"
POSTGRES_DB="safepath_production"

# ── Concurrency & Performance (OCI Ampere A1 ARM64) ──────────────────────────
# Standard OCI Free Tier has 4 OCPUs and 24 GB RAM. 2-4 workers is optimal.
WEB_CONCURRENCY="2"

# ── CORS Restrictions ────────────────────────────────────────────────────────
# For mobile Android apps, "*" or your production domain can be specified.
ALLOWED_ORIGINS="*"

# ── Machine Learning Risk Model ──────────────────────────────────────────────
ML_MODEL_PATH="/app/models/area_risk_model.joblib"
